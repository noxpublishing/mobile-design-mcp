# Optional custom local library location. App records, captures and flows live here.
# MOBILE_DESIGN_DATA_DIR=/absolute/path/to/mobile-design-library

# Mobbin MCP normally uses: npm run mobbin:login
# A short-lived OAuth token can alternatively be supplied through the environment.
# MOBBIN_MCP_ACCESS_TOKEN=

# REST is a different entitlement (Team/Enterprise); current native platform is iOS.
# MOBBIN_API_KEY=
